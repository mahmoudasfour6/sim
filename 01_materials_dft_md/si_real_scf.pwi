&CONTROL
  calculation = 'scf'
  prefix = 'si_bulk'
  outdir = './tmp_qe'
  pseudo_dir = '/home/mahmoudasfour/sim_data/pseudopotentials'
  tprnfor = .true.
  tstress = .true.
/
&SYSTEM
  ibrav = 2
  celldm(1) = 10.2631
  nat = 2
  ntyp = 1
  ecutwfc = 24.0
  ecutrho = 192.0
/
&ELECTRONS
  conv_thr = 1.0d-7
/
ATOMIC_SPECIES
  Si  28.0855  Si.pbe-n-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS (alat)
  Si 0.00 0.00 0.00
  Si 0.25 0.25 0.25
K_POINTS (automatic)
  4 4 4 1 1 1
